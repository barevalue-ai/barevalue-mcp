{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.quietnotion/barevalue",
    "title": "Barevalue",
    "description": "AI podcast editing. Sign up in one call, send audio by link or from disk, get an edited episode.",
    "repository": {
        "url": "https://github.com/quietnotion/barevalue-mcp",
        "source": "github"
    },
    "version": "1.4.1",
    "remotes": [
        {
            "type": "streamable-http",
            "url": "https://barevalue.com/mcp"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "barevalue-mcp",
            "version": "1.4.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "description": "Optional Barevalue API key. Without one the agent calls barevalue_register and gets a key at once.",
                    "isRequired": false,
                    "format": "string",
                    "isSecret": true,
                    "name": "BAREVALUE_API_KEY"
                }
            ]
        }
    ]
}
